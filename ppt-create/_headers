# 배포 루트가 ppt-create 일 때 적용되는 사본 (이유는 저장소 루트의 _headers 주석 참고)

/js/*
  Cache-Control: no-cache
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/css/*
  Cache-Control: no-cache
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/presets.json
  Cache-Control: no-cache
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
