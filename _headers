# Cloudflare Pages 캐시 규칙 (배포 루트가 저장소 루트일 때 적용)
#
# ES 모듈은 파일 단위로 캐시된다. 일부만 옛 파일이 남으면 "미리보기는 새 기능,
# 내보내기는 옛 동작" 처럼 앞뒤가 안 맞는 상태가 되고 오류도 안 뜬다.
# no-cache = 매번 서버에 확인(대부분 304, 용량 거의 안 씀) → 항상 같은 판이 돈다.

/ppt-create/js/*
  Cache-Control: no-cache

/ppt-create/css/*
  Cache-Control: no-cache

/ppt-create/presets.json
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

/css/*
  Cache-Control: no-cache
